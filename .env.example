# Maileroo sending key (Dashboard → Domain → Sending Keys)
MAILEROO_API_KEY=

# Must be a verified sender on your Maileroo domain
MAILEROO_FROM_EMAIL=hello@cfdesign.studio
MAILEROO_FROM_NAME=Dr. Asher Natural Chiropractic

# Comma-separated clinic inboxes
MAILEROO_TO_EMAILS=info@doctorasher.com,drasherdc@yahoo.com

# Optional override (defaults shown)
# MAILEROO_API_URL=https://smtp.maileroo.com/api/v2/emails
# CONTACT_ALLOWED_ORIGINS=https://doctorasher.com,http://localhost:3000
# PORT=3000
